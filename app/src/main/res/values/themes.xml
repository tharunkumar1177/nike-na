<?xml version="1.0" encoding="utf-8"?>
<!-- Window themes for Music: the splash theme shown at launch and the edge-to-edge app theme. -->
<resources>

    <style name="Theme.Music" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.Music.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Music</item>
    </style>

</resources>
